# ============ LLM（阶段一）============
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方现行模型名；旧名 deepseek-v4-flash 已下线，请求会被路由到 V4.1-Flash
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ============ web_search（阶段一，client-side 实现）============
# DeepSeek Responses API 不支持服务端 web_search，故由本项目自行调用搜索 API
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# ============ 沙箱（阶段一）============
SANDBOX_WORKSPACE=/workspace
SANDBOX_MAX_COMMANDS=500
SANDBOX_MAX_LOOP_ITERATIONS=5000
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_READ_BYTES=51200        # read 默认 50KB 截断
SANDBOX_MAX_WRITE_BYTES=1048576     # write 默认 1MB 上限

# ============ Agent 终止条件（阶段一）============
AGENT_MAX_STEPS=10
TOOL_MAX_RETRIES=2

# ============ 可观测（阶段一）============
LOG_LEVEL=INFO
LOG_JSON=true

# ============ 短期记忆（阶段二）============
POSTGRES_DSN=postgresql://memagent:memagent@localhost:5432/memagent

# ============ 长期记忆（阶段二）============
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
# 阶段二再定，留空则启动时报错提醒
EMBEDDING_MODEL=

# ============ 记忆治理权重（阶段二，禁止硬编码）============
MEMORY_SCORE_ALPHA=0.25
MEMORY_SCORE_BETA=0.25
MEMORY_SCORE_GAMMA=0.25
MEMORY_SCORE_DELTA=0.25
MEMORY_DECAY_LAMBDA=0.01
MEMORY_INJECT_MAX_PREFERENCE=4
MEMORY_INJECT_MAX_TOTAL=8

# ============ Agentic RAG（阶段三）============
QUALITY_GATE_THRESHOLD=0.6
MAX_BACKTRACK_COUNT=2
RAG_MAX_RETRIEVAL_ROUNDS=5
RAG_MAX_INPUT_TOKENS=50000
RAG_MAX_OUTPUT_TOKENS=10000
RAG_MAX_ELAPSED_SECONDS=30

# ============ 可观测（阶段三）============
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000